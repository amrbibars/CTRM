<Window x:Class="CTRM.StaffingAndScheduling"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CTRM"
        mc:Ignorable="d"
        Title="Staffing and Scheduling" Height="450" Width="800"
        Background="{StaticResource AppWindowBackground}">

    <!-- 🔹 Make ALL buttons in this window use App.xaml's ButtonBaseStyle -->
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}"/>
    </Window.Resources>

    <Grid Background="{x:Null}" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- load buttons -->
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <!-- status -->
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <!-- concept + inputs + calculate -->
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <!-- preview grid -->
        </Grid.RowDefinitions>

        <!-- Load actions -->
        <StackPanel Orientation="Horizontal" Grid.Row="0">
            <Button Content="Load Volumes" Click="LoadVolumes_Click" Margin="0,0,12,0"/>
            <Button Content="Load AHT"     Click="LoadAht_Click"/>
        </StackPanel>

        <!-- Status -->
        <TextBlock x:Name="StatusText" Grid.Row="2" FontSize="14" />

        <!-- Concept selection + Inputs + Calculate -->
        <StackPanel Grid.Row="4">
            <TextBlock Text="Select Staffing Concept:"
                       FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <StackPanel Margin="12,0,0,12">
                <RadioButton x:Name="ConceptErlangC" Content="1. Erlang C" GroupName="Concepts"
                             Checked="Concept_Checked"/>
                <RadioButton x:Name="ConceptWorkload" Content="2. Workload" GroupName="Concepts"
                             Checked="Concept_Checked"/>
                <RadioButton x:Name="ConceptMixed" Content="3. Mixed (Multi-channel Agents)" GroupName="Concepts" 
                             IsEnabled="False"
                             Checked="Concept_Checked"/>
            </StackPanel>

            <!-- Unified Inputs -->
            <Border Padding="10" CornerRadius="8" BorderBrush="#00493E" BorderThickness="1">
    <StackPanel>
        <TextBlock Text="Inputs" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <WrapPanel Orientation="Horizontal">
            <WrapPanel.Resources>
                <Style TargetType="StackPanel">
                    <Setter Property="Margin" Value="0,0,20,10"/>
                    <Setter Property="Width" Value="140"/>
                </Style>
                <Style TargetType="TextBlock">
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="Margin" Value="0,0,0,4"/>
                </Style>
                <Style TargetType="TextBox">
                    <Setter Property="Height" Value="24"/>
                </Style>
            </WrapPanel.Resources>

            <StackPanel><TextBlock Text="SLA (0–1):"/><TextBox x:Name="TxtSla" PreviewTextInput="Decimal_PreviewTextInput" DataObject.Pasting="Decimal_Paste"/></StackPanel>
            <StackPanel><TextBlock Text="Time (Sec):"/><TextBox x:Name="TxtTimeSec" PreviewTextInput="Int_PreviewTextInput" DataObject.Pasting="Int_Paste"/></StackPanel>
            <StackPanel><TextBlock Text="Occupancy (0–1):"/><TextBox x:Name="TxtOcc" Text="0.85" PreviewTextInput="Decimal_PreviewTextInput" DataObject.Pasting="Decimal_Paste"/></StackPanel>
            <StackPanel><TextBlock Text="Shrinkage (0–1):"/><TextBox x:Name="TxtShrink" Text="0.30" PreviewTextInput="Decimal_PreviewTextInput" DataObject.Pasting="Decimal_Paste"/></StackPanel>
            
            <StackPanel Width="160">
                <TextBlock Text="Interval:"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <RadioButton x:Name="Interval1800" Content="1800 sec" GroupName="Interval" IsChecked="True"/>
                    <RadioButton x:Name="Interval3600" Content="3600 sec" GroupName="Interval" Margin="12,0,0,0"/>
                </StackPanel>
            </StackPanel>

            <StackPanel><TextBlock Text="Net Shift (Hrs):"/><TextBox x:Name="TxtShiftDuration" Text="7" PreviewTextInput="Decimal_PreviewTextInput" DataObject.Pasting="Decimal_Paste"/></StackPanel>
            <StackPanel><TextBlock Text="Days Off (Int):"/><TextBox x:Name="TxtDaysOff" Text="2" PreviewTextInput="Int_PreviewTextInput" DataObject.Pasting="Int_Paste"/></StackPanel>
        </WrapPanel>
    </StackPanel>
</Border>

            <Button Content="Calculate Staffing"
                    Width="200" Height="40" Margin="0,12,0,0"
                    Click="CalculateStaffing_Click"/>

            <Button Content="Export to Excel"
                    x:Name="BtnExport"
                    Width="200" Height="40" Margin="0,8,0,0"
                    Click="ExportToExcel_Click"
                    IsEnabled="False"/>

        </StackPanel>

        <!-- Preview grid -->
        <DataGrid x:Name="PreviewGrid"
          Grid.Row="6"
          IsReadOnly="True"
          AutoGenerateColumns="True"
          CanUserAddRows="False"
          CanUserDeleteRows="False"
          
          HeadersVisibility="All" 
          RowHeaderWidth="70"
          ColumnWidth="SizeToCells"
          HorizontalAlignment="Left"
          VerticalGridLinesBrush="#E0E0E0"
          HorizontalGridLinesBrush="#E0E0E0">

            <DataGrid.Resources>

                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Height" Value="35"/>
                    <Setter Property="Background" Value="#F5F5F5"/>
                    <Setter Property="BorderBrush" Value="#CCCCCC"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                </Style>

                <Style TargetType="DataGridRowHeader">
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Background" Value="#F5F5F5"/>
                    <Setter Property="BorderBrush" Value="#CCCCCC"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                </Style>

                <Style TargetType="DataGridCell">
                    <Setter Property="TextBlock.TextAlignment" Value="Center"/>
                    <Setter Property="Padding" Value="5,2"/>
                </Style>

            </DataGrid.Resources>
        </DataGrid>
    </Grid>
</Window>
